# ---------------------------------------------------------------------------
# job-search-automation candidate profile
#
# Copy this file to profiles/<name>.yaml (one file per person/role you want
# to search jobs for) and edit it. profiles/*.yaml are gitignored — only
# this .example stays tracked. A run walks every profile in profiles/ and
# writes its own report to profiles/output/<name>/.
# ---------------------------------------------------------------------------

# Used as the report folder name (profiles/output/<name>/) and as the
# default when this file is profiles/<name>.yaml. Letters, numbers, - and _.
name: andres

# Free-text profile injected into every LLM prompt. Write it as you'd want
# an interviewer to read it.
profile: |
  Senior AI Infrastructure Engineer with 10+ years of experience.
  Stack: Python, FastAPI, Django, Vue.js, PostgreSQL, Docker, AWS, Linux.
  Experience in AI Infrastructure, RAG, LLMs, agents.
  Flagship project: an open-source AI assistant for Linux.
  Based in Colombia, available for US timezones (EST/PST).
  Looking for senior remote roles with competitive compensation.

# Keyword lists used by the (cheap, pre-LLM) filtering stage. Each profile
# keeps its own — two people searching from the same account can look for
# completely different roles.
keywords:
  # A listing must contain at least one of these to be considered at all.
  target:
    - ai engineer
    - machine learning
    - llm
    - rag
    - agent
    - prompt engineering
    - ai infrastructure
    - ai platform
    - generative ai
    - genai
    - ml engineer
    - python
    - fastapi
    - django
    - vue
    - vuejs
    - postgresql
    - linux
    - docker
    - kubernetes
    - aws
    - senior
    - lead
    - staff
    - principal
    - architect
    - fullstack
    - backend
    - infrastructure

  # A listing containing any of these is dropped, no matter what else matches.
  exclude:
    - junior
    - intern
    - internship
    - entry level
    - trainee
    - fresher
    - graduate
    - analyst
    - volunteer
    - unpaid
    - contractor
    - housekeeper
    - cleaner
    - driver
    - manager
    - director
    - officer
    - specialist
    - coordinator
    - administrator

  # Used to detect seniority in a title (drives per-provider pre-filtering).
  seniority:
    - senior
    - lead
    - staff
    - principal

  # Used to detect AI-related postings (drives per-provider pre-filtering).
  ai:
    - ai
    - machine learning
    - llm
    - rag
    - agent

  # A listing must match at least one of these to count as "technical".
  tech:
    - software
    - developer
    - engineer
    - architect
    - python
    - django
    - vue
    - react
    - javascript
    - backend
    - frontend
    - fullstack
    - infrastructure
    - ai
    - machine learning
    - llm
    - rag
    - agent

# Where this profile's own reports are written, under
# <output_base_dir>/<name>/ (output_base_dir comes from config.yaml,
# defaults to profiles/output).
output:
  csv_filename: job_matches.csv
  md_filename: job_matches.md

# Reserved for future work: sending this profile's digest via Telegram once
# that lands. Not used yet — safe to leave as-is.
telegram:
  enabled: false
  chat_id: null
